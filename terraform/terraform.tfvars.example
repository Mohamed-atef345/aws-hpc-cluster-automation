aws_region       = "us-east-1"
availability_zone = "us-east-1a"

project_name = "hpc-slurm-freeipa"
environment  = "dev"
owner        = "mohamed-atef"

vpc_cidr               = "10.20.0.0/16"
public_subnet_cidr     = "10.20.0.0/24"
private_subnet_cidr = "10.20.10.0/24"

# Replace this with a trusted Rocky Linux 9 AMI from your selected region.
ami_id = "ami-replace-me"

freeipa_instance_type   = "t3.medium"
controller_instance_type = "t3.medium"
login_instance_type     = "t3.small"
compute_instance_type   = "t3.small"
compute_count           = 2

root_volume_type = "gp3"
root_volume_size = 20

freeipa_domain = "hpc.test"
